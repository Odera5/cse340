
<%- include('partials/header') %>

<main>

  <h1><%= title %></h1>

  <h2><%= categoryDetails[0].name %></h2>

  <p>
    <a href="/edit-category/<%= categoryDetails[0].category_id %>">
      Edit Category
    </a>
  </p>

  <h3>Projects in this category:</h3>

  <ul>

    <% if (categoryDetails[0].project_id) { %>

      <% categoryDetails.forEach((service) => { %>

        <li>
          <a href="/project/<%= service.project_id %>">
            <%= service.title %>
          </a>
        </li>

      <% }); %>

    <% } else { %>

      <li>No projects in this category.</li>

    <% } %>

  </ul>

</main>

<%- include('partials/footer') %>
