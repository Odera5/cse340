```html
<%- include('partials/header') %>

<main>

  <h1><%= title %></h1>

  <h2><%= projectDetails[0].title %></h2>

  <p>
    <strong>Description:</strong>
    <%= projectDetails[0].description %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= projectDetails[0].location %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= projectDetails[0].date %>
  </p>

  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= projectDetails[0].organization_id %>">
      <%= projectDetails[0].organization_name %>
    </a>
  </p>

  <p>
    <strong>Categories:</strong>
  </p>

  <ul>
    <% let hasCategories = false; %>

    <% projectDetails.forEach((category) => { %>
      <% if (category.category_id) { %>
        <% hasCategories = true; %>
        <li>
          <a href="/categories/<%= category.category_id %>">
            <%= category.category_name %>
          </a>
        </li>
      <% } %>
    <% }); %>

    <% if (!hasCategories) { %>
      <li>No categories assigned to this project.</li>
    <% } %>
  </ul>

  <p>
    <a href="/edit-project/<%= projectDetails[0].project_id %>">
      Edit Project
    </a>
  </p>

</main>

<%- include('partials/footer') %>
```
