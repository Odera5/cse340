<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <form
    action="/edit-organization/<%= organizationDetails.organization_id %>"
    method="POST"
    enctype="multipart/form-data"
  >
    <label for="organization_name">Organization Name:</label>
    <input
      type="text"
      id="organization_name"
      name="organization_name"
      value="<%= organizationDetails.organization_name %>"
      required
    />

    <label for="description">Description:</label>
    <textarea id="description" name="description" required>
<%= organizationDetails.description %></textarea
    >

    <label for="email">Email:</label>
    <input
      type="email"
      id="email"
      name="email"
      value="<%= organizationDetails.email %>"
      required
    />

    <label for="logo">Logo:</label>

    <img
      src="/images/<%= organizationDetails.logo_filename %>"
      alt="Current organization logo"
      width="100"
    />

    <input type="file" id="logo" name="logo" />

    <button type="submit">Update Organization</button>
  </form>
</main>
<%- include('partials/footer') %>
