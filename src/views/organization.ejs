<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2><%= organizationDetails.organization_name %></h2>

  <p>
    <strong>Description:</strong>
    <%= organizationDetails.description %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= organizationDetails.email %>
  </p>

<img
src="/images/<%= organizationDetails.logo_filename %>"
alt="<%= organizationDetails.organization_name %> logo"

>

  <h2>Service Projects</h2>

<% if (projects.length > 0) { %> <ul>
<% projects.forEach((project) => { %> <li> <a href="/project/<%= project.project_id %>">
<%= project.title %> </a> </li>
<% }); %> </ul>
<% } else { %> <p>No service projects are currently associated with this organization.</p>
<% } %>

  <p>
    <a href="/edit-organization/<%= organizationDetails.organization_id %>">
      Edit Organization
    </a>
  </p>
</main>

<%- include('partials/footer') %>
