
<%- include("partials/header") %>

<main>
  <h1>Registered Users</h1>

  <p>View all registered users and their assigned roles.</p>

  <% if (users && users.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
        </tr>
      </thead>

      <tbody>
        <% users.forEach((registeredUser) => { %>
          <tr>
            <td><%= registeredUser.name %></td>
            <td><%= registeredUser.email %></td>
            <td><%= registeredUser.role_name %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>No registered users were found.</p>
  <% } %>

  <p><a href="/dashboard">Back to Dashboard</a></p>
</main>

<%- include("partials/footer") %>
